---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnalyzerApp from "../../components/analyzer/AnalyzerApp";
import { gitShaFull } from "../../lib/buildMeta";
---
<BaseLayout
  title="Analizador de mazos MTG — Structural"
  description="Analiza tu export de MTG Arena: estructura del mazo, roles y share URL. 100% client-side."
  lang="es"
>
  <Fragment slot="head">
    <meta name="git-sha" content={gitShaFull} />
  </Fragment>
  <Fragment set:html={`<!-- git: ${gitShaFull} -->`} />
  <div class="analyzer-theme">
    <section class="analyzer-hero">
      <h1>Analizador de mazos MTG</h1>
      <p class="muted">
        Herramienta estructural para MTG Arena. Sin servidor, sin cuentas, 100% local.
      </p>
    </section>

    <AnalyzerApp client:load buildSha={gitShaFull} />
  </div>
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(1000px 420px at 8% -12%, rgba(74, 99, 176, 0.22), rgba(9, 12, 18, 0) 60%),
      radial-gradient(760px 340px at 92% 0%, rgba(43, 57, 109, 0.18), rgba(10, 12, 18, 0) 62%),
      linear-gradient(180deg, #090c12 0%, #0c1017 46%, #0a0e14 100%);
  }

  .analyzer-theme {
    position: relative;
    margin-top: 14px;
    padding: 24px 18px 20px;
    border-radius: 20px;
    border: 1px solid rgba(128, 152, 220, 0.16);
    background:
      linear-gradient(180deg, rgba(26, 33, 52, 0.38), rgba(14, 18, 28, 0.58) 32%, rgba(12, 16, 24, 0.72) 100%),
      radial-gradient(600px 220px at 0% 0%, rgba(97, 120, 197, 0.16), rgba(19, 24, 37, 0) 66%);
    box-shadow:
      0 24px 54px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    overflow: hidden;
  }

  .analyzer-theme::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(120deg, rgba(150, 175, 255, 0.05), rgba(150, 175, 255, 0)),
      radial-gradient(450px 140px at 14% -8%, rgba(168, 192, 255, 0.08), rgba(0, 0, 0, 0) 72%);
  }

  .analyzer-hero {
    position: relative;
    z-index: 1;
    margin: 0 0 20px;
    padding: 12px 8px 2px;
  }

  .analyzer-hero h1 {
    margin: 0 0 10px;
    font-size: clamp(34px, 6vw, 44px);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: #eef2ff;
    text-wrap: balance;
  }

  .analyzer-hero .muted {
    margin: 0;
    max-width: 72ch;
    font-size: 15px;
    line-height: 1.7;
    color: rgba(199, 208, 231, 0.85);
  }

  .analyzer {
    position: relative;
    z-index: 1;
    margin-top: 10px;
    gap: 18px;
  }
  .analyzer textarea {
    width: 100%;
    min-height: 200px;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid rgba(131, 150, 207, 0.3);
    background:
      linear-gradient(180deg, rgba(18, 23, 36, 0.96), rgba(12, 16, 24, 0.98));
    color: var(--text);
    font-size: 14px;
    line-height: 1.6;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
    transition: border-color 140ms ease, box-shadow 180ms ease, background 180ms ease;
  }
  .analyzer textarea:focus-visible,
  .analyzer .share-url:focus-visible {
    outline: none;
    border-color: rgba(142, 168, 255, 0.75);
    box-shadow:
      0 0 0 3px rgba(94, 123, 219, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .analyzer button:not(.link-button) {
    margin-top: 10px;
    padding: 10px 15px;
    border-radius: 12px;
    border: 1px solid rgba(128, 151, 214, 0.34);
    background: linear-gradient(180deg, rgba(30, 38, 60, 0.95), rgba(19, 25, 39, 0.98));
    color: #e6ecff;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow:
      0 8px 22px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: transform 120ms ease, border-color 140ms ease, box-shadow 180ms ease, filter 180ms ease;
  }
  .analyzer button:not(.link-button):hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
    border-color: rgba(149, 173, 236, 0.58);
    box-shadow:
      0 12px 26px rgba(8, 10, 18, 0.42),
      0 0 0 1px rgba(116, 143, 219, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .analyzer button:not(.link-button):focus-visible {
    outline: none;
    border-color: rgba(166, 188, 250, 0.8);
    box-shadow:
      0 0 0 3px rgba(106, 133, 218, 0.25),
      0 10px 24px rgba(0, 0, 0, 0.35);
  }
  .analyzer .panel:first-of-type button:not(.link-button):first-of-type {
    background: linear-gradient(180deg, #6f8ff8 0%, #5f7de0 55%, #4f69bf 100%);
    color: #f7f9ff;
    border-color: rgba(179, 198, 255, 0.45);
    box-shadow:
      0 14px 30px rgba(47, 66, 132, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.26);
  }
  .analyzer .panel:first-of-type button:not(.link-button):first-of-type:hover {
    filter: brightness(1.07) saturate(1.05);
    border-color: rgba(205, 219, 255, 0.7);
    box-shadow:
      0 16px 32px rgba(47, 66, 132, 0.54),
      0 0 0 1px rgba(150, 173, 250, 0.32),
      inset 0 1px 0 rgba(255, 255, 255, 0.32);
  }
  .analyzer .panel {
    margin: 18px 0;
    padding: 16px;
    border-radius: 16px;
    border: 1px solid rgba(126, 146, 200, 0.22);
    background:
      linear-gradient(180deg, rgba(22, 28, 43, 0.92), rgba(15, 19, 31, 0.94) 65%, rgba(12, 16, 25, 0.96));
    box-shadow:
      0 10px 26px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }
  .analyzer .panel:hover {
    border-color: rgba(155, 177, 238, 0.35);
    box-shadow:
      0 14px 32px rgba(0, 0, 0, 0.34),
      0 0 0 1px rgba(110, 136, 211, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .analyzer .panel h2 {
    margin: 0 0 10px;
    font-size: clamp(21px, 2.9vw, 26px);
    line-height: 1.25;
    letter-spacing: -0.018em;
    color: #ecf1ff;
  }
  .analyzer .panel h3 {
    font-size: 15px;
    font-weight: 600;
    color: #dbe5ff;
    letter-spacing: -0.01em;
  }
  .analyzer .panel > .muted {
    color: rgba(193, 204, 231, 0.78);
  }
  .analyzer .badge {
    display: inline-block;
    padding: 5px 11px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(53, 68, 116, 0.45), rgba(35, 46, 79, 0.35));
    border: 1px solid rgba(137, 161, 230, 0.45);
    color: #cfdbff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }
  .analyzer table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid rgba(123, 142, 195, 0.2);
    border-radius: 12px;
    overflow: hidden;
    background: rgba(12, 16, 25, 0.44);
  }
  .analyzer th,
  .analyzer td {
    text-align: left;
    padding: 8px 10px;
    border-bottom: 1px solid rgba(119, 138, 188, 0.18);
    font-size: 14px;
  }
  .analyzer th {
    color: #d9e4ff;
    background: rgba(79, 97, 154, 0.16);
    font-weight: 600;
  }
  .analyzer tr:last-child td {
    border-bottom: 0;
  }
  .analyzer .issues {
    margin: 12px 0 0;
    padding-left: 20px;
    color: rgba(221, 229, 255, 0.88);
  }
  .analyzer .share-url {
    width: 100%;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid rgba(131, 150, 207, 0.3);
    background: linear-gradient(180deg, rgba(18, 23, 36, 0.96), rgba(12, 16, 24, 0.98));
    color: var(--text);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }
  .analyzer .link-button {
    color: #baccff;
  }
  .analyzer .link-button:hover {
    color: #e6eeff;
  }
  @media (max-width: 560px) {
    .analyzer-theme {
      border-radius: 16px;
      padding: 18px 12px 14px;
    }
    .analyzer-hero {
      margin-bottom: 14px;
      padding: 8px 4px 0;
    }
    .analyzer textarea {
      min-height: 160px;
      padding: 12px;
    }
    .analyzer .panel {
      margin: 14px 0;
      padding: 13px;
    }
    .analyzer th,
    .analyzer td {
      font-size: 13px;
      padding: 7px 8px;
    }
  }
</style>
