---
const { title = "Amazon (afiliado)", text, href, label } = Astro.props;
---

<div class="affiliate-box">
  <h2>{title}</h2>
  {text && <p class="affiliate-summary">{text}</p>}
  <ul class="affiliate-links">
    <li>
      <a class="affiliate-cta" href={href} target="_blank" rel="sponsored nofollow noopener">
        {label}
      </a>
    </li>
  </ul>
  <p class="affiliate-note">
    Nota: enlace de afiliado. Si compras desde aquí, MTGSynergy puede recibir una pequeña comisión sin coste extra para ti.
  </p>
</div>
