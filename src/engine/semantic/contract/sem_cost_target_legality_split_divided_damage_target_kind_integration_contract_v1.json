    "modal_selection_model_independent_extraction_only": true,
    "preserve_existing_rings": true,
    "semantic_migration_requires_explicit_future_phase": true
  },
  "split_divided_damage_target_kind_integration_contract": {
    "split_model_kind_required": "SPLIT_DIVIDED_DAMAGE_TARGET_MODEL",
    "contract_is_not_extraction_implementation": true,
    "must_not_widen_runtime_behavior": true,
    "explicit_evidence_required_for_target_kind_derivation": true,
    "allowed_target_kind_candidates_when_explicit_evidence_exists": [
      "CREATURE",
      "PLAYER",
      "PLANESWALKER",
      "BATTLE",
      "ANY_TARGET"
    ],
    "forbidden_legality_inference_kinds_from_split_wording": [
      "CAST_ONLY_IF",
      "ACTIVATE_ONLY_AS_SORCERY",
      "CONTROLS_X",
      "ATTACKED_THIS_TURN",
      "ONCE_EACH_TURN",
      "OTHER_LEGALITY_TEXT"
    ],
    "forbidden_in_target_or_model_channels": [
      "CAST_ONLY_IF",
      "ACTIVATE_ONLY_AS_SORCERY"
    ],
    "unknown_model_fallback": "UNKNOWN_SPLIT_DIVIDED_DAMAGE_TARGET_MODEL",
    "any_number_targets_policy": "ANY_NUMBER_OF_TARGETS_MIN_SLOT_IS_CONSERVATIVE_0",
    "notes": [
      "split_divided_damage_target_model remains the source model for future split/divided target-kind integration.",
      "target_kinds derived from split/divided damage must stay diagnostic aggregation only in this contract phase.",
      "target_kinds must not replace split_divided_damage_target_model, target_count, or modal_selection_model.",
      "legality gates are out of scope for split/divided target-kind integration."
    ]
  },
