---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnalyzerApp from "../../components/analyzer/AnalyzerApp";
import { gitShaFull } from "../../lib/buildMeta";
---
<BaseLayout
  title="Analizador de mazos MTG — Structural"
  description="Analiza tu export de MTG Arena: estructura del mazo, roles y share URL. 100% client-side."
  lang="es"
>
  <Fragment slot="head">
    <meta name="git-sha" content={gitShaFull} />
  </Fragment>
  <Fragment set:html={`<!-- git: ${gitShaFull} -->`} />
  <div class="analyzer-theme">
    <section class="analyzer-hero">
      <h1>Analizador de mazos MTG</h1>
      <p class="muted">
        Herramienta estructural para MTG Arena. Sin servidor, sin cuentas, 100% local.
      </p>
    </section>

    <AnalyzerApp client:load buildSha={gitShaFull} />
  </div>
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(1200px 520px at -10% -18%, rgba(76, 121, 255, 0.34), rgba(8, 10, 16, 0) 60%),
      radial-gradient(980px 460px at 108% -8%, rgba(132, 87, 241, 0.26), rgba(9, 12, 18, 0) 64%),
      radial-gradient(820px 360px at 48% 112%, rgba(42, 152, 186, 0.18), rgba(9, 12, 18, 0) 66%),
      linear-gradient(180deg, #05070d 0%, #090d16 45%, #070a12 100%);
  }

  .analyzer-theme {
    position: relative;
    margin-top: 18px;
    padding: 30px 22px 24px;
    border-radius: 24px;
    border: 1px solid rgba(146, 171, 247, 0.3);
    background:
      linear-gradient(180deg, rgba(23, 31, 51, 0.82) 0%, rgba(13, 18, 31, 0.9) 42%, rgba(10, 14, 24, 0.95) 100%),
      radial-gradient(760px 260px at 4% -4%, rgba(98, 126, 225, 0.26), rgba(18, 24, 38, 0) 65%);
    box-shadow:
      0 34px 84px rgba(0, 0, 0, 0.58),
      0 0 0 1px rgba(110, 139, 226, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
    overflow: hidden;
  }

  .analyzer-theme::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(120deg, rgba(158, 186, 255, 0.1), rgba(158, 186, 255, 0) 52%),
      radial-gradient(520px 150px at 12% -6%, rgba(172, 195, 255, 0.12), rgba(0, 0, 0, 0) 72%);
  }

  .analyzer-theme::after {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1px rgba(188, 207, 255, 0.07),
      inset 0 18px 42px rgba(96, 126, 219, 0.1);
  }

  .analyzer-hero {
    position: relative;
    z-index: 1;
    margin: 0 0 24px;
    padding: 10px 10px 4px;
  }

  .analyzer-hero h1 {
    margin: 0 0 12px;
    font-size: clamp(40px, 6.8vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.032em;
    font-weight: 760;
    color: #f2f6ff;
    text-shadow: 0 8px 22px rgba(33, 49, 104, 0.45);
    text-wrap: balance;
  }

  .analyzer-hero .muted {
    margin: 0;
    max-width: 70ch;
    font-size: 16px;
    line-height: 1.72;
    color: rgba(211, 222, 248, 0.92);
  }

  .analyzer {
    position: relative;
    z-index: 1;
    margin-top: 14px;
    gap: 24px;
  }
  .analyzer textarea {
    width: 100%;
    min-height: 236px;
    padding: 16px 18px;
    border-radius: 16px;
    border: 1px solid rgba(145, 167, 229, 0.42);
    background:
      linear-gradient(180deg, rgba(19, 25, 40, 0.97), rgba(11, 15, 25, 0.99)),
      radial-gradient(380px 140px at 6% 0%, rgba(82, 106, 182, 0.24), rgba(11, 15, 25, 0) 64%);
    color: var(--text);
    font-size: 14px;
    line-height: 1.62;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 10px 24px rgba(0, 0, 0, 0.28);
    transition: border-color 140ms ease, box-shadow 180ms ease, background 180ms ease;
  }
  .analyzer .panel:first-of-type textarea {
    min-height: 260px;
  }
  .analyzer textarea:focus-visible,
  .analyzer .share-url:focus-visible {
    outline: none;
    border-color: rgba(174, 195, 255, 0.88);
    box-shadow:
      0 0 0 3px rgba(109, 139, 235, 0.3),
      0 14px 30px rgba(20, 29, 57, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .analyzer textarea:focus-visible,
  .analyzer .share-url:focus-visible,
  .analyzer button:not(.link-button):focus-visible,
  .analyzer .link-button:focus-visible {
    outline: 2px solid rgba(219, 230, 255, 0.95);
    outline-offset: 2px;
  }
  .analyzer button:not(.link-button) {
    margin-top: 10px;
    padding: 11px 16px;
    border-radius: 13px;
    border: 1px solid rgba(136, 159, 219, 0.46);
    background: linear-gradient(180deg, rgba(34, 43, 67, 0.96), rgba(18, 24, 39, 0.99));
    color: #e9efff;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow:
      0 10px 26px rgba(0, 0, 0, 0.34),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition: transform 120ms ease, border-color 140ms ease, box-shadow 180ms ease, filter 180ms ease;
    touch-action: manipulation;
  }
  .analyzer button:not(.link-button):hover {
    transform: translateY(-1px) scale(1.01);
    filter: brightness(1.08);
    border-color: rgba(176, 196, 246, 0.68);
    box-shadow:
      0 14px 30px rgba(9, 12, 22, 0.48),
      0 0 0 1px rgba(123, 149, 224, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
  .analyzer button:not(.link-button):focus-visible {
    outline: none;
    border-color: rgba(189, 208, 255, 0.9);
    box-shadow:
      0 0 0 3px rgba(109, 139, 234, 0.3),
      0 12px 26px rgba(0, 0, 0, 0.42);
  }
  .analyzer .panel:first-of-type button:not(.link-button):first-of-type {
    margin-top: 14px;
    min-width: 180px;
    padding: 13px 24px;
    border-radius: 14px;
    border: 1px solid rgba(196, 212, 255, 0.66);
    background: linear-gradient(145deg, #7ea7ff 0%, #6c8ff6 46%, #6d63de 100%);
    color: #f7f9ff;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.015em;
    box-shadow:
      0 18px 34px rgba(60, 88, 182, 0.55),
      0 0 0 1px rgba(137, 161, 235, 0.34),
      inset 0 1px 0 rgba(255, 255, 255, 0.32);
  }
  .analyzer .panel:first-of-type button:not(.link-button):first-of-type:hover {
    transform: translateY(-2px) scale(1.01);
    filter: brightness(1.1) saturate(1.08);
    border-color: rgba(225, 234, 255, 0.84);
    box-shadow:
      0 22px 38px rgba(68, 96, 193, 0.62),
      0 0 0 1px rgba(165, 186, 252, 0.44),
      inset 0 1px 0 rgba(255, 255, 255, 0.38);
  }
  .analyzer .panel:first-of-type button:not(.link-button):first-of-type:focus-visible {
    border-color: rgba(236, 242, 255, 0.95);
    box-shadow:
      0 0 0 4px rgba(132, 161, 247, 0.38),
      0 22px 38px rgba(68, 96, 193, 0.62),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  .analyzer .panel {
    position: relative;
    overflow: hidden;
    margin: 24px 0;
    padding: 20px;
    border-radius: 18px;
    border: 1px solid rgba(142, 164, 226, 0.34);
    background:
      linear-gradient(180deg, rgba(21, 28, 44, 0.94), rgba(14, 19, 32, 0.95) 58%, rgba(10, 14, 24, 0.98)),
      radial-gradient(500px 160px at 0% 0%, rgba(98, 126, 219, 0.1), rgba(21, 28, 44, 0) 70%);
    box-shadow:
      0 16px 34px rgba(0, 0, 0, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }
  .analyzer .panel::before {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    top: 0;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(144, 180, 255, 0.9), rgba(145, 128, 255, 0.65) 48%, rgba(99, 226, 220, 0.72));
  }
  .analyzer .panel:hover {
    transform: translateY(-1px);
    border-color: rgba(184, 203, 250, 0.5);
    box-shadow:
      0 20px 38px rgba(0, 0, 0, 0.44),
      0 0 0 1px rgba(123, 151, 233, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .analyzer .panel h2 {
    position: relative;
    margin: 0 0 12px;
    padding-left: 14px;
    font-size: clamp(22px, 3.1vw, 28px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #eef3ff;
    text-shadow: 0 3px 14px rgba(28, 43, 88, 0.35);
  }
  .analyzer .panel h2::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.18em;
    bottom: 0.16em;
    width: 4px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(163, 190, 255, 0.95), rgba(112, 216, 216, 0.85));
  }
  .analyzer .panel h3 {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    color: #e5edff;
    letter-spacing: -0.01em;
  }
  .analyzer .panel > p {
    line-height: 1.7;
    color: rgba(226, 233, 255, 0.92);
    overflow-wrap: anywhere;
  }
  .analyzer .muted {
    color: rgba(211, 222, 248, 0.88);
    line-height: 1.72;
    overflow-wrap: anywhere;
  }
  .analyzer .badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 999px;
    background: linear-gradient(145deg, rgba(78, 106, 196, 0.5), rgba(61, 83, 159, 0.35) 58%, rgba(88, 74, 155, 0.36));
    border: 1px solid rgba(187, 205, 255, 0.58);
    color: #e6eeff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.025em;
    box-shadow:
      0 8px 18px rgba(18, 28, 60, 0.34),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }
  .analyzer table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid rgba(139, 159, 217, 0.3);
    border-radius: 12px;
    overflow: hidden;
    background: rgba(11, 15, 25, 0.56);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }
  .analyzer th,
  .analyzer td {
    text-align: left;
    padding: 9px 11px;
    border-bottom: 1px solid rgba(123, 143, 198, 0.22);
    font-size: 14px;
  }
  .analyzer th {
    color: #e0e9ff;
    background: linear-gradient(180deg, rgba(88, 109, 176, 0.3), rgba(61, 78, 130, 0.18));
    font-weight: 600;
  }
  .analyzer tr:last-child td {
    border-bottom: 0;
  }
  .analyzer tbody tr {
    transition: background 140ms ease;
  }
  .analyzer tbody tr:hover td {
    background: rgba(109, 132, 199, 0.1);
  }
  .analyzer .issues {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    color: rgba(223, 231, 253, 0.92);
  }
  .analyzer .issues li {
    position: relative;
    padding: 9px 11px 9px 24px;
    border-radius: 10px;
    border: 1px solid rgba(136, 159, 220, 0.28);
    background: rgba(14, 20, 33, 0.74);
    overflow-wrap: anywhere;
  }
  .analyzer .issues li::before {
    content: "";
    position: absolute;
    left: 10px;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    transform: translateY(-50%);
    background: rgba(147, 175, 255, 0.92);
    box-shadow: 0 0 0 3px rgba(147, 175, 255, 0.18);
  }
  .analyzer .share-url {
    width: 100%;
    padding: 11px 13px;
    border-radius: 13px;
    border: 1px solid rgba(145, 167, 229, 0.42);
    background:
      linear-gradient(180deg, rgba(19, 25, 40, 0.97), rgba(11, 15, 25, 0.99));
    color: var(--text);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 8px 20px rgba(0, 0, 0, 0.24);
  }
  .analyzer .link-button {
    color: #c3d4ff;
    border-color: rgba(152, 175, 235, 0.45);
    touch-action: manipulation;
  }
  .analyzer .link-button:hover {
    color: #edf3ff;
  }
  .analyzer .metric-coach-block {
    margin-top: 14px;
    display: grid;
    gap: 10px;
  }
  .analyzer .metric-coach {
    border-radius: 12px;
    border: 1px solid rgba(138, 160, 220, 0.28);
    background: linear-gradient(180deg, rgba(24, 31, 49, 0.9), rgba(16, 21, 34, 0.92));
    padding: 10px 12px;
    overflow-wrap: anywhere;
  }
  .analyzer .metric-coach-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px 10px;
    margin-bottom: 4px;
  }
  .analyzer .metric-coach-line strong {
    font-size: 13px;
    letter-spacing: 0.01em;
    color: #e9f0ff;
  }
  .analyzer .metric-coach-line > span {
    color: rgba(223, 232, 255, 0.9);
    overflow-wrap: anywhere;
  }
  .analyzer .metric-coach .muted {
    margin: 3px 0 0;
    line-height: 1.62;
  }
  .analyzer .level-chip {
    min-width: 52px;
    text-align: center;
    border-width: 1px;
  }
  .analyzer .level-chip.level-low {
    border-color: rgba(127, 222, 176, 0.7);
    background: linear-gradient(145deg, rgba(69, 147, 115, 0.62), rgba(46, 95, 77, 0.44));
  }
  .analyzer .level-chip.level-mid {
    border-color: rgba(246, 197, 117, 0.76);
    background: linear-gradient(145deg, rgba(171, 126, 61, 0.62), rgba(111, 82, 40, 0.44));
  }
  .analyzer .level-chip.level-high {
    border-color: rgba(245, 144, 144, 0.76);
    background: linear-gradient(145deg, rgba(163, 85, 92, 0.66), rgba(112, 58, 68, 0.46));
  }
  .analyzer .status-section {
    margin-top: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid rgba(137, 159, 221, 0.26);
    background: rgba(12, 17, 28, 0.64);
  }
  .analyzer .status-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 8px;
  }
  .analyzer .status-badge {
    min-width: 40px;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.03em;
  }
  .analyzer .status-ok {
    border-color: rgba(128, 220, 179, 0.72);
    background: linear-gradient(145deg, rgba(66, 146, 112, 0.64), rgba(38, 96, 72, 0.46));
  }
  .analyzer .status-warn {
    border-color: rgba(245, 180, 129, 0.78);
    background: linear-gradient(145deg, rgba(168, 116, 63, 0.62), rgba(111, 73, 36, 0.46));
  }
  .analyzer .status-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin-top: 7px;
  }
  .analyzer .status-details {
    margin-top: 8px;
    padding: 9px 11px;
    border-radius: 10px;
    border: 1px solid rgba(133, 154, 210, 0.3);
    background: rgba(15, 21, 34, 0.78);
    font-size: 13px;
    line-height: 1.6;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .analyzer .status-toggle {
    margin-top: 4px;
  }
  .analyzer .link-button:focus-visible {
    border-color: rgba(197, 213, 255, 0.82);
    box-shadow: 0 0 0 3px rgba(108, 138, 229, 0.28);
    border-radius: 8px;
  }

  @media (prefers-reduced-motion: reduce) {
    .analyzer *,
    .analyzer-theme,
    .analyzer-theme::before,
    .analyzer-theme::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    .analyzer .panel:hover,
    .analyzer button:not(.link-button):hover,
    .analyzer .panel:first-of-type button:not(.link-button):first-of-type:hover {
      transform: none !important;
    }
  }

  @media (max-width: 560px) {
    .analyzer-theme {
      border-radius: 18px;
      padding: 20px 13px 15px;
    }
    .analyzer {
      gap: 16px;
    }
    .analyzer-hero {
      margin-bottom: 16px;
      padding: 6px 4px 0;
    }
    .analyzer-hero h1 {
      font-size: clamp(34px, 11vw, 44px);
    }
    .analyzer-hero .muted {
      font-size: 15px;
    }
    .analyzer textarea {
      min-height: 180px;
      padding: 12px;
      font-size: 16px;
    }
    .analyzer .panel:first-of-type textarea {
      min-height: 220px;
    }
    .analyzer .share-url {
      font-size: 16px;
      padding: 10px 12px;
    }
    .analyzer .panel {
      margin: 16px 0;
      padding: 14px 12px;
    }
    .analyzer .panel h2 {
      padding-left: 12px;
    }
    .analyzer button:not(.link-button) {
      width: 100%;
      justify-content: center;
    }
    .analyzer .panel:first-of-type button:not(.link-button):first-of-type {
      width: 100%;
      min-width: 0;
    }
    .analyzer table {
      display: block;
      overflow-x: auto;
      touch-action: pan-x;
      -webkit-overflow-scrolling: touch;
      max-width: 100%;
      border-radius: 10px;
    }
    .analyzer th,
    .analyzer td {
      font-size: 13px;
      padding: 7px 8px;
      white-space: nowrap;
    }
    .analyzer .metric-coach {
      padding: 9px 10px;
    }
    .analyzer .metric-coach-line {
      gap: 6px 8px;
    }
    .analyzer .status-section {
      padding: 10px 11px;
    }
    .analyzer .status-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 7px 8px;
    }
    .analyzer .status-details {
      font-size: 12px;
      line-height: 1.55;
    }
    .analyzer .issues {
      gap: 7px;
    }
    .analyzer .issues li {
      padding: 8px 9px 8px 22px;
      font-size: 13px;
    }
  }

  @media print {
    @page {
      margin: 12mm;
    }

    :global(html),
    :global(body) {
      background: #fff !important;
      color: #111 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .analyzer *,
    .analyzer-theme,
    .analyzer-theme::before,
    .analyzer-theme::after {
      transition: none !important;
      animation: none !important;
      transform: none !important;
      box-shadow: none !important;
      text-shadow: none !important;
      filter: none !important;
    }

    .analyzer-theme::before,
    .analyzer-theme::after,
    .analyzer .panel::before {
      content: none !important;
      display: none !important;
    }

    .analyzer-theme {
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: #fff !important;
      overflow: visible !important;
    }

    .analyzer {
      margin-top: 0 !important;
      gap: 5mm !important;
      background: #fff !important;
      overflow: visible !important;
    }

    .analyzer-hero {
      margin: 0 0 4mm !important;
      padding: 0 !important;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .analyzer-hero h1,
    .analyzer .panel h2,
    .analyzer .panel h3 {
      color: #111 !important;
    }

    .analyzer-hero .muted,
    .analyzer .muted,
    .analyzer .panel > p {
      color: #333 !important;
      line-height: 1.45 !important;
    }

    .analyzer .panel {
      margin: 0 0 4mm !important;
      padding: 3.5mm !important;
      border: 1px solid #d9d9d9 !important;
      border-radius: 2mm !important;
      background: #fff !important;
      overflow: visible !important;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .analyzer .badge,
    .analyzer .level-chip,
    .analyzer .status-badge {
      background: #f6f6f6 !important;
      color: #111 !important;
      border: 1px solid #cfcfcf !important;
      box-shadow: none !important;
    }

    .analyzer table {
      width: 100% !important;
      display: table !important;
      border-collapse: collapse !important;
      border: 1px solid #d3d3d3 !important;
      background: #fff !important;
      overflow: visible !important;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .analyzer th,
    .analyzer td {
      color: #111 !important;
      border: 1px solid #d9d9d9 !important;
      background: #fff !important;
      padding: 2.2mm !important;
      white-space: normal !important;
      overflow-wrap: anywhere !important;
      word-break: break-word !important;
    }

    .analyzer th {
      background: #f2f2f2 !important;
    }

    .analyzer .issues {
      gap: 2mm !important;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .analyzer .issues li,
    .analyzer .metric-coach,
    .analyzer .status-section,
    .analyzer .status-details {
      background: #fff !important;
      color: #111 !important;
      border: 1px solid #d9d9d9 !important;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .analyzer .issues li::before {
      background: #7c7c7c !important;
      box-shadow: none !important;
    }

    .analyzer textarea,
    .analyzer .panel:first-of-type textarea,
    .analyzer .share-url {
      min-height: 36mm !important;
      border: 1px solid #cfcfcf !important;
      border-radius: 1.5mm !important;
      background: #fff !important;
      color: #111 !important;
      box-shadow: none !important;
      overflow: visible !important;
    }

    .analyzer button:not(.link-button),
    .analyzer .link-button {
      background: #fff !important;
      color: #111 !important;
