{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtgsynergy.local/tools/family_qualification/family_qualification_report.schema.json",
  "title": "Family Qualification Report v1 Bootstrap (Minimal)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "verdict",
    "shortlist",
    "bootstrap_shortlist",
    "families"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headShort",
        "originMainShort",
        "repoDirtyGlobal",
        "closurePath",
        "catalogPath"
      ],
      "properties": {
        "headShort": {
          "type": "string",
          "minLength": 1
        },
        "originMainShort": {
          "type": "string",
          "minLength": 1
        },
        "repoDirtyGlobal": {
          "type": "boolean"
        },
        "closurePath": {
          "type": "string",
          "minLength": 1
        },
        "catalogPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "NO_CLEAN_CANDIDATE",
        "RECONCILIATION_REQUIRED",
        "SHORTLIST_READY"
      ]
    },
    "shortlist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bootstrap_shortlist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "family_scope",
          "status",
          "status_reason",
          "promotion_eligible_for_real_seed",
          "promotion_blocker_kind",
          "tracked_contract_hits",
          "tracked_test_hits",
          "tracked_wiring_hits",
          "untracked_homonym_hits",
          "closure_positive_hits",
          "closure_negative_hits",
          "closure_absorbed_hits",
          "contradiction_flags",
          "epistemic_basis"
        ],
        "properties": {
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "family_scope": {
            "type": "string",
            "enum": [
              "REAL_SEED",
              "BOOTSTRAP"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "CLOSED",
              "VETOED",
              "CONTAMINATED_BY_WORKTREE",
              "ABSORBED",
              "NEEDS_RECONCILIATION",
              "INSUFFICIENT_ANCHOR",
              "OPEN_CANDIDATE"
            ]
          },
          "status_reason": {
            "type": "string",
            "minLength": 1
          },
          "promotion_eligible_for_real_seed": {
            "type": "boolean"
          },
          "promotion_blocker_kind": {
            "type": "string",
            "enum": [
              "NONE",
              "WORKTREE_CONTAMINATION",
              "NEEDS_RECONCILIATION",
              "INSUFFICIENT_ANCHOR",
              "AUXILIARY_TEST_ONLY_EXCLUSION",
              "ALREADY_CLOSED",
              "ALREADY_ABSORBED",
              "CLOSURE_NEGATIVE"
            ]
          },
          "tracked_contract_hits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tracked_test_hits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tracked_wiring_hits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "untracked_homonym_hits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "closure_positive_hits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "closure_negative_hits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "closure_absorbed_hits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contradiction_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "epistemic_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo_inspection",
              "worktree_inspection",
              "closure_scan",
              "inference_used"
            ],
            "properties": {
              "repo_inspection": {
                "type": "boolean"
              },
              "worktree_inspection": {
                "type": "boolean"
              },
              "closure_scan": {
                "type": "boolean"
              },
              "inference_used": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
