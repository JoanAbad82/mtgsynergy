    "required_fields": [
      "kind",
      "mode_selection_kind",
      "selected_modes_min",
      "selected_modes_max",
      "modes_total",
      "targeted_modes_count",
      "conceptual_target_slots_min",
      "conceptual_target_slots_max",
      "aggregated_target_kinds",
      "notes",
      "known_gap"
    ],
    "mode_selection_kind_enum": [
      "CHOOSE_ONE",
      "CHOOSE_TWO",
      "CHOOSE_ONE_OR_MORE",
      "SPLIT_DIVIDED_DAMAGE_NON_MODAL",
      "UNKNOWN_MODAL_SELECTION"
    ],
    "split_divided_damage_separate_from_modal_normal": true,
    "unknown_modal_selection_fallback_required": true,
    "total_function_fallback_required": true,
    "forbidden_in_aggregated_target_kinds": [
      "CAST_ONLY_IF",
      "ACTIVATE_ONLY_AS_SORCERY"
    ],
    "notes": [
      "modal_selection_model is additive in v1 and does not replace target_kinds or target_count.",
      "target_kinds and target_count remain diagnostic aggregation channels in v1.",
      "split/divided damage remains a separate category from modal selection."
    ]
  },
