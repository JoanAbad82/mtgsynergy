---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Explorador de Sinergias MTG (Beta) — MTGSynergy"
  description="Vista previa técnica para explorar candidatos no rankeados a partir de una o dos cartas MTG. Sin ranking, score ni explicación causal todavía."
  lang="es"
>
  <section class="beta-shell">
    <p class="beta-kicker">Estado: beta informativa</p>
    <h1>Explorador de Sinergias MTG (Beta)</h1>
    <p class="lead">
      Esta beta pública muestra el flujo de interfaz actual del explorador. Hoy trabaja con
      <strong> candidatos no rankeados</strong> a nivel de vista previa y todavía no presenta una
      lista ordenada por sinergia.
    </p>
    <p class="notice">No calcula ranking, score ni explicación causal de sinergia todavía.</p>

    <div class="beta-card">
      <h2>Entrada beta</h2>
      <p class="input-hint">
        La entrada local de una o dos cartas ya está disponible en esta beta pública. Esta shell
        prepara estado local y no tiene conexión pública al engine.
      </p>
      <div class="beta-input-grid" data-cse-beta-entry aria-label="Entrada beta local">
        <div class="beta-input-field">
          <label for="cse-beta-seed-1">Carta seed 1</label>
          <input
            id="cse-beta-seed-1"
            type="text"
            placeholder="Ejemplo: Lightning Bolt"
            autocomplete="off"
          />
        </div>
        <div class="beta-input-field">
          <label for="cse-beta-seed-2">Carta seed 2 opcional</label>
          <input
            id="cse-beta-seed-2"
            type="text"
            placeholder="Ejemplo: Monastery Swiftspear"
            autocomplete="off"
          />
        </div>
        <div class="beta-action-row">
          <button
            id="cse-beta-prepare-btn"
            class="beta-action-btn"
            type="button"
            data-ready="false"
            aria-disabled="true"
          >
            Preparar entrada beta
          </button>
          <button id="cse-beta-clear-btn" class="beta-clear-btn" type="button">
            Limpiar entrada
          </button>
        </div>
        <div id="cse-beta-state" class="beta-state" data-state="idle" aria-live="polite">
          <p class="beta-state-label">Estado local</p>
          <p id="cse-beta-message" class="beta-state-message">Introduce al menos una carta seed.</p>
          <p id="cse-beta-note" class="beta-state-note">
            Esta beta prepara entrada local y puede mostrar un pool inicial no rankeado desde el
            índice local.
          </p>
          <ul id="cse-beta-seed-summary" class="beta-state-list" hidden>
            <li><strong>Seed 1 detectada:</strong> <span id="cse-beta-seed-1-summary"></span></li>
            <li id="cse-beta-seed-2-row" hidden>
              <strong>Seed 2 detectada:</strong> <span id="cse-beta-seed-2-summary"></span>
            </li>
          </ul>
        </div>
      </div>
      <p class="input-footnote">
        Esta entrada beta no ejecuta el motor: solo sincroniza estado local con la vista previa de
        salida. Puede mostrar un pool inicial filtrado de candidatos reales no rankeados desde el
        índice local. No calcula ranking, no calcula score ni explicación causal de sinergia. La
        versión pública seguirá siendo 100% client-side.
      </p>
    </div>

    <div class="beta-card">
      <h2>Vista previa de salida</h2>
      <p>
        Esta vista previa se sincroniza con las seeds introducidas localmente y mantiene formato de
        salida pública para <strong>candidatos no rankeados</strong>.
      </p>
      <div id="cse-beta-output-preview" class="beta-output-empty" data-cse-beta-output data-state="empty" aria-live="polite">
        <p class="beta-output-empty-title">Salida no rankeada pendiente de activación.</p>
        <p id="cse-beta-output-status" class="beta-output-status">Todavía no hay candidatos generados.</p>
        <p id="cse-beta-output-note" class="beta-output-note">Todavía no se generan candidatos reales.</p>
        <ul id="cse-beta-output-seeds" class="beta-output-seeds" hidden>
          <li><strong>Seed 1 preparada:</strong> <span id="cse-beta-output-seed-1"></span></li>
          <li id="cse-beta-output-seed-2-row" hidden>
            <strong>Seed 2 preparada:</strong> <span id="cse-beta-output-seed-2"></span>
          </li>
        </ul>
      </div>
      <div class="beta-output-contract" aria-label="Formato de salida futuro">
        <p class="beta-output-contract-title">Placeholder no rankeado</p>
        <p class="beta-output-contract-intro">
          Formato de salida futuro para la beta pública. Sin candidatos reales.
        </p>
        <dl class="beta-output-contract-grid">
          <dt>Candidato</dt>
          <dd>Candidato no generado todavía</dd>
          <dt>Estado</dt>
          <dd>Placeholder no rankeado</dd>
          <dt>Motivo</dt>
          <dd>Pendiente de conexión controlada al contrato de candidatos</dd>
          <dt>Ranking</dt>
          <dd>Ranking no disponible</dd>
          <dt>Score</dt>
          <dd>Score no disponible</dd>
          <dt>Explicación causal</dt>
          <dd>Explicación causal no disponible</dd>
        </dl>
      </div>
      <ul class="beta-output-guardrails">
        <li>No calcula ranking.</li>
        <li>No calcula score.</li>
        <li>No genera explicación causal.</li>
      </ul>
      <div id="cse-beta-real-pool" class="beta-real-pool" data-state="idle" aria-live="polite">
        <p class="beta-real-pool-title">Candidatos reales no rankeados</p>
        <p class="beta-real-pool-subtitle">Pool inicial desde índice local</p>
        <p class="beta-real-pool-subcopy">Pool inicial filtrado. Filtrado mínimo desde índice local.</p>
        <p id="cse-beta-real-pool-status" class="beta-real-pool-status">
          No hay candidatos reales disponibles todavía para esta entrada.
        </p>
        <ul id="cse-beta-real-pool-list" class="beta-real-pool-list" hidden></ul>
        <ul class="beta-real-pool-guardrails">
          <li>No son recomendaciones finales</li>
          <li>Sin ranking</li>
          <li>Sin score</li>
          <li>Sin explicación causal</li>
          <li>El orden no representa ranking</li>
        </ul>
      </div>
    </div>

    <div class="beta-card">
      <h2>Qué existe ya internamente</h2>
      <ul>
        <li>Resolución de cartas seed.</li>
        <li>Candidate pool real mínimo desde índice local.</li>
        <li>Salida <code>candidateOutputs</code> no rankeada.</li>
        <li>Sin conexión pública al engine desde esta ruta beta.</li>
      </ul>
    </div>

    <div class="beta-card">
      <h2>Qué falta antes de una versión pública completa</h2>
      <ul>
        <li>Ranking de candidatos.</li>
        <li>Scoring.</li>
        <li>Puentes semánticos causales.</li>
        <li>Explicación de sinergia.</li>
        <li>Interfaz interactiva pública.</li>
      </ul>
    </div>

    <div class="beta-card">
      <h2>Próximo paso</h2>
      <p>
        Siguiente paso controlado: mejorar el filtrado y conectar señales semánticas más precisas
        manteniendo salida no rankeada y no definitiva, sin introducir ranking, score ni
        explicación causal.
      </p>
      <p>100% client-side en la evolución pública de esta beta.</p>
      <p>
        Mientras tanto, puedes seguir usando el analizador estructural actual:
        <a href="/es/analizador-de-mazos-mtg/">/es/analizador-de-mazos-mtg/</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-cse-beta-entry]");
    if (!root) return;

    const seed1Input = root.querySelector("#cse-beta-seed-1");
    const seed2Input = root.querySelector("#cse-beta-seed-2");
    const prepareButton = root.querySelector("#cse-beta-prepare-btn");
    const clearButton = root.querySelector("#cse-beta-clear-btn");
    const statePanel = root.querySelector("#cse-beta-state");
    const stateMessage = root.querySelector("#cse-beta-message");
    const stateNote = root.querySelector("#cse-beta-note");
    const seedSummary = root.querySelector("#cse-beta-seed-summary");
    const seed1Summary = root.querySelector("#cse-beta-seed-1-summary");
    const seed2Row = root.querySelector("#cse-beta-seed-2-row");
    const seed2Summary = root.querySelector("#cse-beta-seed-2-summary");
    const shell = root.closest(".beta-shell");

    if (!(shell instanceof HTMLElement)) return;

    const outputPreview = shell.querySelector("#cse-beta-output-preview");
    const outputStatus = shell.querySelector("#cse-beta-output-status");
    const outputNote = shell.querySelector("#cse-beta-output-note");
    const outputSeeds = shell.querySelector("#cse-beta-output-seeds");
    const outputSeed1 = shell.querySelector("#cse-beta-output-seed-1");
    const outputSeed2Row = shell.querySelector("#cse-beta-output-seed-2-row");
    const outputSeed2 = shell.querySelector("#cse-beta-output-seed-2");
    const realPool = shell.querySelector("#cse-beta-real-pool");
    const realPoolStatus = shell.querySelector("#cse-beta-real-pool-status");
    const realPoolList = shell.querySelector("#cse-beta-real-pool-list");

    if (
      !(seed1Input instanceof HTMLInputElement) ||
      !(seed2Input instanceof HTMLInputElement) ||
      !(prepareButton instanceof HTMLButtonElement) ||
      !(clearButton instanceof HTMLButtonElement) ||
      !(statePanel instanceof HTMLElement) ||
      !(stateMessage instanceof HTMLElement) ||
      !(stateNote instanceof HTMLElement) ||
      !(seedSummary instanceof HTMLElement) ||
      !(seed1Summary instanceof HTMLElement) ||
      !(seed2Row instanceof HTMLElement) ||
      !(seed2Summary instanceof HTMLElement) ||
      !(outputPreview instanceof HTMLElement) ||
      !(outputStatus instanceof HTMLElement) ||
      !(outputNote instanceof HTMLElement) ||
      !(outputSeeds instanceof HTMLElement) ||
      !(outputSeed1 instanceof HTMLElement) ||
      !(outputSeed2Row instanceof HTMLElement) ||
      !(outputSeed2 instanceof HTMLElement) ||
      !(realPool instanceof HTMLElement) ||
      !(realPoolStatus instanceof HTMLElement) ||
      !(realPoolList instanceof HTMLElement)
    ) {
      return;
    }

    const CANDIDATE_LIMIT = 8;
    let cardsIndexCache = null;
    let cardsIndexPromise = null;
    const STOPWORDS = new Set([
      "about",
      "after",
      "against",
      "another",
      "any",
      "because",
      "before",
      "between",
      "can",
      "choose",
      "control",
      "cost",
      "could",
      "damage",
      "deals",
      "draw",
      "each",
      "from",
      "have",
      "into",
      "its",
      "may",
      "one",
      "only",
      "other",
      "target",
      "that",
      "their",
      "them",
      "then",
      "this",
      "those",
      "until",
      "when",
      "with",
      "your",
    ]);
    const PLAYABLE_TYPES = [
      "artifact",
      "battle",
      "creature",
      "enchantment",
      "instant",
      "land",
      "planeswalker",
      "sorcery",
    ];
    const DAMAGE_SIGNAL_RE =
      /\b(damage|deals?|target|combat damage|cast|copy|spell|spells|instant|sorcery)\b/;
    const SPELL_SIGNAL_RE = /\b(cast|spell|spells|instant|sorcery|copy)\b/;
    const COMBAT_SIGNAL_RE = /\b(combat|attacks?|blocks?|creature)\b/;

    const normalizeName = (value) => {
      return value.normalize("NFKC").trim().replace(/\s+/g, " ").toLowerCase();
    };

    const isNonEmptyString = (value) => {
      return typeof value === "string" && value.trim().length > 0;
    };

    const hasUsableOracleText = (record) => {
      return isNonEmptyString(record?.oracle_text);
    };

    const tokenize = (value) => {
      if (!isNonEmptyString(value)) {
        return [];
      }

      const parts = value.toLowerCase().match(/[a-z0-9]+/g) ?? [];
      return parts.filter((token) => token.length >= 4 && !STOPWORDS.has(token) && !/^\d+$/.test(token));
    };

    const extractPrimaryTypes = (typeLine) => {
      if (!isNonEmptyString(typeLine)) {
        return [];
      }

      const base = typeLine.split("—")[0].split("-")[0].toLowerCase();
      return PLAYABLE_TYPES.filter((type) => base.includes(type));
    };

    const buildSeedSignals = (seedName, seedRecord) => {
      const seedText = isNonEmptyString(seedRecord?.oracle_text)
        ? seedRecord.oracle_text.toLowerCase()
        : "";
      const seedType = isNonEmptyString(seedRecord?.type_line)
        ? seedRecord.type_line.toLowerCase()
        : "";
      const seedTokens = [...tokenize(seedName), ...tokenize(seedText)];
      const uniqueSeedTokens = [];
      const seen = new Set();
      for (const token of seedTokens) {
        if (seen.has(token)) continue;
        seen.add(token);
        uniqueSeedTokens.push(token);
        if (uniqueSeedTokens.length >= 16) {
          break;
        }
      }

      const primaryTypes = extractPrimaryTypes(seedType);
      const hasInstantOrSorcerySeed =
        primaryTypes.includes("instant") || primaryTypes.includes("sorcery");
      const hasCreatureSeed = primaryTypes.includes("creature");

      return {
        seedTokens: uniqueSeedTokens,
        primaryTypes,
        hasInstantOrSorcerySeed,
        hasCreatureSeed,
        expectsDamageSignals: /\b(damage|deals?)\b/.test(seedText),
        expectsSpellSignals:
          /\b(cast|spells?|copy)\b/.test(seedText) || hasInstantOrSorcerySeed,
        expectsCombatSignals: /\bcombat damage\b/.test(seedText) || hasCreatureSeed,
      };
    };

    const isLikelyPlayableRecord = (name, record) => {
      if (!isNonEmptyString(name) || !record || !hasUsableOracleText(record)) {
        return false;
      }

      if (isNonEmptyString(record.type_line)) {
        const primaryTypes = extractPrimaryTypes(record.type_line);
        if (primaryTypes.length === 0) {
          return false;
        }
      }

      return true;
    };

    const scoreCandidateMatch = (signals, name, record) => {
      const text = isNonEmptyString(record?.oracle_text) ? record.oracle_text.toLowerCase() : "";
      const type = isNonEmptyString(record?.type_line) ? record.type_line.toLowerCase() : "";
      const searchable = `${normalizeName(name)} ${type} ${text}`;

      let lexicalHits = 0;
      for (const token of signals.seedTokens) {
        if (searchable.includes(token)) {
          lexicalHits += 1;
        }
      }

      const candidateTypes = extractPrimaryTypes(record?.type_line);
      let sharedType = false;
      for (const seedType of signals.primaryTypes) {
        if (candidateTypes.includes(seedType)) {
          sharedType = true;
          break;
        }
      }

      const hasDamageSignal = signals.expectsDamageSignals && DAMAGE_SIGNAL_RE.test(searchable);
      const hasSpellSignal = signals.expectsSpellSignals && SPELL_SIGNAL_RE.test(searchable);
      const hasCombatSignal = signals.expectsCombatSignals && COMBAT_SIGNAL_RE.test(searchable);

      let thematicHits = 0;
      if (hasDamageSignal) thematicHits += 1;
      if (hasSpellSignal) thematicHits += 1;
      if (hasCombatSignal) thematicHits += 1;

      const maybeRelevant =
        lexicalHits >= 1 || thematicHits >= 1 || (sharedType && signals.primaryTypes.length > 0);
      if (!maybeRelevant) {
        return null;
      }

      return {
        lexicalHits,
        thematicHits,
        sharedType: sharedType ? 1 : 0,
      };
    };

    const compareCandidateRows = (left, right) => {
      if (right.match.lexicalHits !== left.match.lexicalHits) {
        return right.match.lexicalHits - left.match.lexicalHits;
      }
      if (right.match.thematicHits !== left.match.thematicHits) {
        return right.match.thematicHits - left.match.thematicHits;
      }
      if (right.match.sharedType !== left.match.sharedType) {
        return right.match.sharedType - left.match.sharedType;
      }
      return left.name.localeCompare(right.name, "es");
    };

    const decodeCardsIndexPayload = async (bytes) => {
      const isGzip = bytes.length >= 2 && bytes[0] === 0x1f && bytes[1] === 0x8b;
      if (!isGzip) {
        return new TextDecoder("utf-8").decode(bytes);
      }

      if (typeof DecompressionStream !== "undefined") {
        const ds = new DecompressionStream("gzip");
        const stream = new Blob([bytes]).stream().pipeThrough(ds);
        return new Response(stream).text();
      }

      throw new Error("No gzip decompressor available in this browser.");
    };

    const loadCardsIndexLocal = async () => {
      if (cardsIndexCache) {
        return cardsIndexCache;
      }
      if (cardsIndexPromise) {
        return cardsIndexPromise;
      }

      cardsIndexPromise = (async () => {
        const response = await fetch("/data/cards_index.json.gz");
        if (!response.ok) {
          throw new Error(`cards_index unavailable (${response.status}).`);
        }

        const bytes = new Uint8Array(await response.arrayBuffer());
        const rawPayload = await decodeCardsIndexPayload(bytes);
        const payload = JSON.parse(rawPayload);
        cardsIndexCache = payload;
        return payload;
      })();

      return cardsIndexPromise;
    };

    const resolveCanonicalSeedName = (payload, seedName) => {
      const trimmedSeed = seedName.trim();
      if (!trimmedSeed) {
        return null;
      }

      if (payload?.by_name?.[trimmedSeed]) {
        return trimmedSeed;
      }

      const normalizedSeed = normalizeName(trimmedSeed);
      const canonicalFromMap = payload?.by_name_norm?.[normalizedSeed];
      if (canonicalFromMap && payload?.by_name?.[canonicalFromMap]) {
        return canonicalFromMap;
      }

      for (const name of Object.keys(payload?.by_name ?? {})) {
        if (normalizeName(name) === normalizedSeed) {
          return name;
        }
      }

      return null;
    };

    const collectRealCandidates = (payload, seed1Name, seed2Name) => {
      const canonicalSeed1 = resolveCanonicalSeedName(payload, seed1Name);
      const canonicalSeed2 = resolveCanonicalSeedName(payload, seed2Name);
      if (!canonicalSeed1) {
        return {
          foundSeed1: false,
          candidates: [],
        };
      }

      const excludedSeeds = new Set([canonicalSeed1]);
      if (canonicalSeed2) {
        excludedSeeds.add(canonicalSeed2);
      }

      const seedRecord = payload?.by_name?.[canonicalSeed1];
      if (!seedRecord || !hasUsableOracleText(seedRecord)) {
        return {
          foundSeed1: false,
          candidates: [],
        };
      }

      const seedSignals = buildSeedSignals(canonicalSeed1, seedRecord);
      const candidateRows = [];
      for (const [name, candidateRecord] of Object.entries(payload?.by_name ?? {})) {
        if (excludedSeeds.has(name)) {
          continue;
        }
        if (!isLikelyPlayableRecord(name, candidateRecord)) {
          continue;
        }

        const match = scoreCandidateMatch(seedSignals, name, candidateRecord);
        if (!match) {
          continue;
        }

        candidateRows.push({ name, match });
      }

      candidateRows.sort(compareCandidateRows);
      const candidates = [];
      for (const row of candidateRows) {
        candidates.push(row.name);
        if (candidates.length >= CANDIDATE_LIMIT) {
          break;
        }
      }

      return {
        foundSeed1: true,
        candidates,
      };
    };

    const renderRealPoolEmpty = (message) => {
      realPool.dataset.state = "empty";
      realPoolStatus.textContent = message;
      realPoolList.hidden = true;
      realPoolList.innerHTML = "";
    };

    const renderRealPoolCandidates = (candidates) => {
      realPool.dataset.state = "ready";
      realPoolStatus.textContent =
        "La entrada se ha preparado localmente y se muestra un pool inicial filtrado.";
      realPoolList.hidden = false;
      realPoolList.innerHTML = "";

      for (const candidateName of candidates) {
        const item = document.createElement("li");
        item.textContent = candidateName;
        realPoolList.appendChild(item);
      }
    };

    const readSeeds = () => {
      return {
        seed1: seed1Input.value.trim(),
        seed2: seed2Input.value.trim(),
      };
    };

    const syncPrepareButton = () => {
      const { seed1 } = readSeeds();
      const isReady = seed1.length > 0;
      prepareButton.dataset.ready = isReady ? "true" : "false";
      prepareButton.setAttribute("aria-disabled", isReady ? "false" : "true");
    };

    const setState = (message, seed1, seed2) => {
      stateMessage.textContent = message;
      stateNote.textContent =
        "Esta beta pública mantiene guardrails: sin ranking, sin score y sin explicación causal.";

      if (!seed1) {
        statePanel.dataset.state = "warning";
        seedSummary.hidden = true;
        seed1Summary.textContent = "";
        seed2Summary.textContent = "";
        seed2Row.hidden = true;
        return;
      }

      statePanel.dataset.state = "ready";
      seedSummary.hidden = false;
      seed1Summary.textContent = seed1;

      if (seed2) {
        seed2Summary.textContent = seed2;
        seed2Row.hidden = false;
      } else {
        seed2Summary.textContent = "";
        seed2Row.hidden = true;
      }
    };

    const setOutputState = (state, seed1, seed2) => {
      if (state === "warning") {
        outputPreview.dataset.state = "warning";
        outputStatus.textContent = "Introduce al menos una carta seed.";
        outputNote.textContent = "Todavía no se generan candidatos reales.";
        outputSeeds.hidden = true;
        outputSeed1.textContent = "";
        outputSeed2.textContent = "";
        outputSeed2Row.hidden = true;
        return;
      }

      if (state === "prepared") {
        outputPreview.dataset.state = "prepared";
        outputStatus.textContent = "Entrada preparada localmente.";
        outputNote.textContent =
          "Vista previa sincronizada con seeds locales. Sin ranking, sin score y sin explicación causal.";
        outputSeeds.hidden = false;
        outputSeed1.textContent = seed1;

        if (seed2) {
          outputSeed2.textContent = seed2;
          outputSeed2Row.hidden = false;
        } else {
          outputSeed2.textContent = "";
          outputSeed2Row.hidden = true;
        }
        return;
      }

      outputPreview.dataset.state = "empty";
      outputStatus.textContent = "Todavía no hay candidatos generados.";
      outputNote.textContent = "Todavía no se generan candidatos reales.";
      outputSeeds.hidden = true;
      outputSeed1.textContent = "";
      outputSeed2.textContent = "";
      outputSeed2Row.hidden = true;
    };

    const prepareEntry = () => {
      const { seed1, seed2 } = readSeeds();

      if (!seed1) {
        setState("Introduce al menos una carta seed.", "", "");
        setOutputState("warning", "", "");
        renderRealPoolEmpty("No hay candidatos reales disponibles todavía para esta entrada.");
        return;
      }

      setState("Entrada preparada localmente.", seed1, seed2);
      setOutputState("prepared", seed1, seed2);

      loadCardsIndexLocal()
        .then((payload) => {
          const result = collectRealCandidates(payload, seed1, seed2);
          if (!result.foundSeed1) {
            renderRealPoolEmpty("No se ha encontrado una carta seed real en el índice local.");
            return;
          }

          if (result.candidates.length === 0) {
            renderRealPoolEmpty("No hay candidatos reales disponibles todavía para esta entrada.");
            return;
          }

          renderRealPoolCandidates(result.candidates);
        })
        .catch(() => {
          renderRealPoolEmpty("No hay candidatos reales disponibles todavía para esta entrada.");
        });
    };

    const handleEnter = (event) => {
      if (event.key !== "Enter") return;
      event.preventDefault();
      prepareEntry();
    };

    seed1Input.addEventListener("input", syncPrepareButton);
    seed2Input.addEventListener("input", syncPrepareButton);
    seed1Input.addEventListener("keydown", handleEnter);
    seed2Input.addEventListener("keydown", handleEnter);

    prepareButton.addEventListener("click", () => {
      prepareEntry();
    });

    clearButton.addEventListener("click", () => {
      seed1Input.value = "";
      seed2Input.value = "";
      syncPrepareButton();
      setState("Introduce al menos una carta seed.", "", "");
      setOutputState("empty", "", "");
      renderRealPoolEmpty("No hay candidatos reales disponibles todavía para esta entrada.");
      seed1Input.focus();
    });

    syncPrepareButton();
    setOutputState("empty", "", "");
